# HireAgent Backend Environment Variables Example

PROJECT_NAME="HireAgent API"
API_V1_STR="/api/v1"

# MySQL Database Connection URL
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/hireagent

# JWT Authentication Configuration
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
